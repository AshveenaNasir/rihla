/* THE PREMIUM FORM DESIGN */
.form-group {
    position: relative;
    margin-bottom: 30px;
}

.form-group input, 
.form-group select, 
.form-group textarea {
    width: 100%;
    padding: 18px;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 12px;
    color: #000;
    font-size: 1rem;
    outline: none;
    transition: 0.3s;
}

.form-group select {
    appearance: none; /* Removes standard select arrow */
    cursor: pointer;
    color: #666; /* Gray placeholder color */
}

.form-group select:valid {
    color: #000; /* Turns black once valid option is selected */
}

/* Hides label by default and handles input animation */
.form-group label {
    position: absolute;
    left: 18px;
    top: 18px;
    font-size: 1rem;
    color: #999;
    pointer-events: none;
    transition: 0.3s;
    background: #fff; /* Key for the 'floating label' effect */
    padding: 0 5px;
}

/* Floating Label Animation when focused/filled */
.form-group input:focus + label,
.form-group textarea:focus + label,
.form-group input:not(:placeholder-shown) + label,
.form-group textarea:not(:placeholder-shown) + label {
    top: -10px;
    left: 12px;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--rihla-red);
}

.form-group input:focus, 
.form-group select:focus, 
.form-group textarea:focus {
    border-color: var(--rihla-red);
    box-shadow: 0 0 0 4px rgba(139, 0, 0, 0.03); /* Red-tinted shadow */
}

/* CHECKBOX STYLES */
.checkbox-item {
    display: flex;
    align-items: center;
    gap: 12px;
}

.checkbox-item input {
    width: auto;
    accent-color: var(--rihla-red);
    margin: 0;
}

.checkbox-item label {
    position: relative;
    top: 0;
    left: 0;
    font-size: 0.9rem;
    color: #666;
    background: transparent;
    pointer-events: auto;
}

.checkbox-item label a {
    color: var(--rihla-red);
    text-decoration: underline;
}

.checkbox-group {
    display: flex !important;
    flex-direction: row !important;         /* Puts box and text in a row */
    align-items: flex-start;   /* Vertically centers the checkbox with the text */
    gap: 10px;             /* Adds space between the square and the sentence */
    margin-top: 15px; 
    width: 100%;
    position: relative;     /* Optional: space above the group */
}

.checkbox-group input[type="checkbox"] {
    all: revert;            /* Resets any weird 'absolute' positioning from other styles */
    width: 18px !important;
    height: 18px !important;
    margin: 0 !important;   /* Prevents it from jumping around */
    cursor: pointer;
    flex-shrink: 0;            /* Removes default browser margins */
}

.checkbox-group label {
    font-family: Arial, sans-serif;
    font-size: 0.9rem;
    color: #ff4d4d;        /* Matches the reddish tone in your image */
    font-weight: bold;
    cursor: pointer;
    pointer-events: auto !important;
    all: revert;            /* Clears any 'position: absolute' that causes overlapping */
    display: block;
    
}

.checkbox-group label a {
    pointer-events: auto !important;
    display: inline-block; /* Makes the clickable area more solid */
}

.checkbox-group a {
    color: blue;           /* Matches the blue link in your image */
    text-decoration: underline;
}
/* THE RIHLA RED SUBMIT BUTTON */
.rihla-form-submit {
    width: 100%;
    background: var(--rihla-red); /* Changed from yellow to Rihla Red */
    color: #fff;
    border: none;
    padding: 20px;
    border-radius: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.9rem;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    transition: 0.3s cubic-bezier(0.19, 1, 0.22, 1);
}

.rihla-form-submit:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(139, 0, 0, 0.3);
}

.rihla-form-submit i {
    transition: 0.3s;
}

.rihla-form-submit:hover i {
    transform: translateX(10px);
}


/*This is the faq section*/
.rihla-faq-section {
    padding: 100px 0 120px 0; /* Extra bottom padding to breathe */
    padding-top: 0px;
    background: #fff;
}

.rihla-faq-inner {
    width: 85%;
    margin: 0 auto;
    max-width: 900px; /* Kept narrower for better readability */
}

.faq-header {
    text-align: center;
    margin-bottom: 60px;
}

.faq-header h2 {
    font-size: 3rem;
    font-weight: 900;
    margin: 15px 0;
}

/* ACCORDION DESIGN */
.rihla-accordion {
    border-top: 1px solid #eee;
}

.faq-item {
    border-bottom: 1px solid #eee;
}

.faq-question {
    width: 100%;
    padding: 30px 0;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    text-align: left;
    transition: 0.3s;
}

.faq-question span {
    font-size: 1.2rem;
    font-weight: 700;
    color: #000;
    transition: 0.3s;
}

.faq-question i {
    font-size: 1rem;
    color: #999;
    transition: transform 0.4s ease;
}

/* HOVER EFFECT */
.faq-question:hover span {
    color: var(--rihla-red);
}

/* THE ANSWER BOX */
.faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.faq-answer p {
    padding-bottom: 30px;
    color: #666;
    line-height: 1.7;
    font-size: 1.05rem;
}

/* ACTIVE STATE (Triggered via JS) */
.faq-item.active .faq-answer {
    max-height: 200px; /* Adjust based on content length */
}

.faq-item.active .faq-question i {
    transform: rotate(45deg);
    color: var(--rihla-red);
}
