body{
    background-color: var(--page-bg);
}
:root {
    --rihla-red: #FF4B4B;
    --rihla-yellow: #FFD95A;
    --footer-dark: #121212;
    --page-bg: #ffffff;
}

/* This is default, so the parts that don't have specific styles will inherit these styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

/* 1- This basically handles the navbar styling */
.navbar-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    justify-content: space-between; /* Pushes items to Left, Center, Right */
    align-items: center;
    padding: 20px 60px;
    z-index: 9999 !important;
    background-color: rgba(3, 3, 3, 0.205);
    color: white;
}


/* This section is solely for the logo container */
.logo-container {
    display: flex;
    align-items: center;
    gap: 10px;
}
.logo-img {
    height: 65px;
    width: auto;
}

/* Navigation Menu Styling */
.nav-menu a {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    margin: 0 15px;
    font-size: 15px;
    font-weight: 500;
    transition: color 0.3s ease;
}

.nav-menu a:hover {
    color: var(--rihla-red); 
}

/* This section is for the book now button style */
.header-actions {
    display: flex;
    align-items: center;
    gap: 15px;
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.lang-toggle {
    background: #ff4d4d;
    color: white;
    border: none;
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: bold;
    cursor: pointer;
}

/* 2- Hero section for home page:This section is for slideshow styling */
.slider {
    position: relative;
    height: 100vh; 
    width: 100%;
    overflow: hidden;
    color: white;
}

.slide {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden; /* Added: makes it fully "gone" when not active */
    transition: opacity 1s ease-in-out;
    display: flex;
    align-items: center;
    padding: 0 10%;
    z-index: 1; /* Default background layer */
}

.slide.active { 
    opacity: 1; 
    visibility: visible; /* Added: makes it show up */
    z-index: 5; /* Brings the active slide to the front */
}
.slide-content {
    position: relative;
    z-index: 10; /* Ensures text is always above the background image */
}

.slide-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
    z-index: -1;
}

.slide-content h1 { font-size: 80px; margin-bottom: 10px; }
.slide-content p { max-width: 500px; font-size: 18px; margin-bottom: 20px; }

.cta {
    background: #ff4d4d; color: white; border: none;
    padding: 12px 30px; border-radius: 4px; cursor: pointer; font-weight: bold;
}

.arrow {
    position: absolute; top: 50%; z-index: 10;
    background: rgba(255,255,255,0.2); border: none;
    color: white; padding: 20px; cursor: pointer; border-radius: 75px;
    width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;
}
.prev { left: 20px; }
.next { right: 20px; }

/*This section is basically the bars for the slideshow, the dots at the bottom */
.indicators {
    position: absolute;
    bottom:150px;
    right: 10%;
    display: flex;
    gap: 15px;
    z-index: 10;
}

.dot {
    width: 80px;
    cursor: pointer;
    opacity: 0.6;
    transition: 0.3s;
}

.dot img {
    width: 100%;
    height: 50px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid rgba(255,255,255,0.3);
}

.dot .bar {
    height: 3px;
    width: 0%; /* Starts empty */
    background: #ff4d4d;
    margin-top: 5px;
    transition: width 0.3s;
}

.dot.active { opacity: 1; }
.dot.active .bar { 
    width: 100%;
    background-color: #ff4d4d;
    transition: width 0.5s ease;
 } 

 /*3- This section is basically for the booking form of the home page */
 .booking-section {
    padding: 0 5%;
    background-color: #ffffff;
}

.booking-container {
    background: white;
    margin-top: -100px; /* Overlaps the slider */
    position: relative;
    z-index: 20;
    border-radius: 12px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.15);
    padding: 30px;
}

.form-header {
    text-align: center;
    margin-bottom: 25px;
}

.form-header h3 { font-size: 24px; color: #333; }

.booking-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr); /* 5 columns for desktop */
    gap: 20px;
    align-items: end;
    width: 100%;
}

.input-group {
    display: flex;
    flex-direction: column;
}

.input-group label {
    font-size: 11px;
    text-transform: uppercase;
    font-weight: bold;
    color: #888;
    margin-bottom: 5px;
}

.input-group input, .input-group select, .input-group textarea {
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    outline: none;
}

.input-group.full-width {
    grid-column: 1 / span 5; 
    width: 100%;
} /* Span across all columns */

.form-footer.full-width {
    grid-column: 1 / span 5;
    width: 100%;
}

/* Ensure the input and button inside those containers stretch 100% */
.full-width input,.full-width .submit-btn {
    width: 100%;
    display: block;
}

.submit-btn {
    background: #ff4d4d;
    color: white;
    border: none;
    padding: 15px 40px;
    border-radius: 5px;
    font-weight: bold;
    cursor: pointer;
    width: 100%;
    margin-top: 10px;
    transition: background 0.3s;
}

.submit-btn:hover { background: #e04343; }

/* 4- --- SEPARATE BOOKING PAGE WRAPPER --- */
.confirm-page-wrap {
    padding: 100px 0;
    background: #f8f9fa;
    display: flex;
    justify-content: center;
}

.confirm-box {
    background: #fff;
    width: 85%;
    max-width: 900px;
    padding: 60px;
    border-radius: 40px;
    box-shadow: 0 40px 100px rgba(0,0,0,0.05);
}

.confirm-intro {
    text-align: center;
    margin-bottom: 50px;
}

.confirm-intro h2 {
    font-size: 2.8rem;
    font-weight: 900;
    margin: 10px 0;
}

/* --- FORM GRID --- */
.final-form-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
}

.item { display: flex; flex-direction: column; gap: 8px; }

.item label, .section-label {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--rihla-red);
    letter-spacing: 1px;
}

.item input, .item textarea, .item select {
    padding: 18px;
    border: 1px solid #eee;
    border-radius: 12px;
    background: #fafafa;
    font-size: 1rem;
    outline: none;
    transition: 0.3s;
}

.item input[readonly], .item select[readonly] {
    background: #f0f0f0;
    cursor: not-allowed;
}

.full-width { grid-column: span 2; }

/* --- TIER SELECTION CARDS --- */
.tier-selection-area { margin-top: 20px; }
.tier-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.plan-info-link {
    font-size: 0.8rem;
    color: #666;
    text-decoration: underline;
}

.tier-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.tier-card {
    position: relative;
    cursor: pointer;
}

.tier-card input { display: none; }

.tier-card-inner {
    border: 2px solid #eee;
    padding: 25px;
    border-radius: 20px;
    text-align: center;
    transition: 0.3s;
    background: #fff;
    display: flex;
    flex-direction: column;
}

.tier-name { font-weight: 900; font-size: 1.1rem; margin-bottom: 5px; }
.tier-price { color: #000; font-weight: 700; }
.tier-price small { color: #999; font-weight: 400; }

.tier-card input:checked + .tier-card-inner {
    border-color: var(--rihla-red);
    background: #fffafa;
    box-shadow: 0 10px 25px rgba(139, 0, 0, 0.1);
}

.most-popular-tag {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--rihla-red);
    color: #fff;
    font-size: 0.6rem;
    padding: 4px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    font-weight: 900;
}

/* --- BUTTONS & MODAL --- */
.final-pay-btn {
    grid-column: span 2;
    padding: 22px;
    background: var(--rihla-red);
    color: white;
    border: none;
    border-radius: 15px;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    margin-top: 20px;
    transition: 0.3s;
}

.final-pay-btn:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(139,0,0,0.3); }

.modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    backdrop-filter: blur(8px);
}

.modal-content {
    background: #fff;
    padding: 60px;
    border-radius: 35px;
    text-align: center;
    max-width: 500px;
}

.modal-icon { font-size: 4rem; color: #2ecc71; margin-bottom: 20px; }
.return-home-btn {
    display: inline-block;
    margin-top: 25px;
    padding: 15px 40px;
    background: #000;
    color: #fff;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 800;
}
.payment-area {
    margin-top: 40px;
    padding-top: 30px;
    border-top: 2px dashed #eee;
}

.payment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.secure-badge {
    font-size: 0.7rem;
    color: #2ecc71;
    font-weight: 800;
    text-transform: uppercase;
}

.payment-selection {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 30px;
}

.pay-option input { display: none; }

.pay-box {
    border: 1px solid #eee;
    padding: 15px;
    border-radius: 12px;
    cursor: pointer;
    transition: 0.3s;
}

.pay-box span { display: block; font-weight: 700; font-size: 0.9rem; }
.pay-box small { font-size: 0.7rem; color: #999; }

.pay-option input:checked + .pay-box {
    border-color: var(--rihla-red);
    background: #fffafa;
}

.card-details-grid {
    background: #fcfcfc;
    padding: 25px;
    border-radius: 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.card-input-wrap {
    position: relative;
}

.card-input-wrap i {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: #ccc;
    font-size: 1.5rem;
}

.form-actions {
    display: flex;
    flex-direction: column; /* Stacked for mobile, row for desktop */
    align-items: center;
    gap: 20px;
    margin-top: 30px;
}

.return-home-ghost {
    color: #888;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: 0.3s;
}

.return-home-ghost i {
    font-size: 0.8rem;
    transition: transform 0.3s ease;
}

.return-home-ghost:hover {
    color: var(--rihla-red);
}

.return-home-ghost:hover i {
    transform: translateX(-5px); /* Moves arrow slightly left on hover */
}

/* --- GUEST DROPDOWN SECTION --- */
/* --- GUEST DROPDOWN SECTION --- */
.guest-dropdown {
    background: #2a2a2a !important; /* Solid dark grey to ensure visibility */
    border: 1px solid #ff4d4d;      /* Red border so you can see the box */
    border-radius: 8px;
    margin-bottom: 15px;
    display: block;
    width: 100%;
}

.dropdown-header {
    padding: 15px 20px;
    display: flex !important;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none !important;
}

/* Hide default markers */
.dropdown-header::-webkit-details-marker { display: none !important; }

.guest-title {
    color: #ffffff !important;
    font-family: Arial, sans-serif;
    font-weight: bold;
    font-size: 1rem;
}

/* THE ARROW: Using a solid white block if the 'V' isn't working for you */
.arrow-icon::after {
    content: '▼'; /* Using a standard text character for maximum reliability */
    color: #ffffff;
    font-size: 0.8rem;
    transition: transform 0.3s ease;
    display: inline-block;
}

/* Flip the arrow when open */
.guest-dropdown[open] .arrow-icon::after {
    transform: rotate(180deg);
}

.guest-form-inner {
    padding: 20px;
    background: #1f1f1f;
    border-top: 1px solid rgba(255,255,255,0.1);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

/* 5- This section is for why book rihla in the home page */

.rihla-trust-section {
    padding: 50px 5%;
    background-color: var(--page-bg);
    text-align: center;
}

.trust-container {
    max-width: 1200px;
    margin: 0 auto;
}

.trust-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 15px;
    color: #1a1a1a;
}

.highlight-red { color: var(--rihla-red); }

.trust-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 40px;
}

/* --- Interactive Card --- */
.trust-item {
    padding: 20px;
    transition: all 0.3s ease;
    border-radius: 15px;
}

.trust-item:hover {
    transform: translateY(-10px); /* Lifts the card */
}

/* --- Animated Icons --- */
.trust-icon-box {
    width: 70px;
    height: 70px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 1.8rem;
    transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

/* Red Variant */
.box-red {
    background-color: rgba(255, 75, 75, 0.1);
    color: var(--rihla-red);
}

/* Yellow Variant */
.box-yellow {
    background-color: rgba(255, 217, 90, 0.2);
    color: #b38b00; /* Darker yellow for contrast */
}

/* Hover Animation: Icon expands and background fills in */
.trust-item:hover .box-red {
    background-color: var(--rihla-red);
    color: white;
    transform: rotate(360deg) scale(1.1);
}

.trust-item:hover .box-yellow {
    background-color: var(--rihla-yellow);
    color: white;
    transform: rotate(360deg) scale(1.1);
}

/* --- Text Styles --- */
.trust-item h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 12px;
}

.trust-item p {
    font-size: 0.95rem;
    color: #555;
    line-height: 1.6;
}

/* 6- This section is for the Top destinaitions section in home page */

.rihla-top-destinations {
    padding: 80px 5%;
    background-color: #fff;
    padding-top: 0px;
}

.dest-container {
    max-width: 1250px;
    margin: 0 auto;
}


/* --- The Grid --- */
.dest-grid-interactive {
    display: grid;
    grid-template-columns: repeat(5, 1fr); /* 5 Columns as per inspiration */
    gap: 20px;
}

/* --- The Card Item --- */
.dest-item {
    position: relative;
    cursor: pointer;
    perspective: 1000px;
}

.dest-img-box {
    width: 100%;
    height: 200px; /* Fixed height for consistent look */
    border-radius: 18px; /* Rounded corners as per image */
    overflow: hidden;
    position: relative;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.dest-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
}

.dest-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 30%, rgba(0,0,0,0.8) 100%);
    z-index: 1;
}

/* --- Interactive Text --- */
.dest-text {
    position: absolute;
    bottom: 20px;
    width: 100%;
    text-align: center;
    z-index: 2;
    color: white;
    transition: transform 0.4s ease;
}

.dest-text h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0;
    letter-spacing: 0.5px;
}

.explore-btn {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--rihla-yellow);
    margin-top: 10px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.4s ease;
}

/* --- Hover Effects --- */
.dest-item:hover .dest-img-box {
    transform: translateY(-8px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.2);
}

.dest-item:hover img {
    transform: scale(1.15); /* Zoom effect */
}

.dest-item:hover .dest-text {
    transform: translateY(-10px);
}

.dest-item:hover .explore-btn {
    opacity: 1;
    transform: translateY(0);
}

/* 7- This section is for the upcoming events section styling in home page */
.events-section {
    padding: 80px 5%;
    background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('aeroplane.jpg') center/cover fixed;
    background-size: cover;
    background-attachment: fixed; /* Parallax effect */
    color: white;
}

.events-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 40px;
    height: 100px;
    margin-top: -40px;
}

.header-text h1 { font-size: 35px; letter-spacing: 2px;}
.red-line-short { width: 40px; height: 3px; background: #ff4d4d; margin-top: 5px; }

.explore-all { color: white; text-decoration: none; font-weight: bold; font-size: 14px; }

.events-scroll-container {
    display: flex;
    overflow-x: auto;
    gap: 25px;
    padding-bottom: 20px;
    scrollbar-width: thin;
    scrollbar-color: #ff4d4d transparent;
}

.event-card {
    flex: 0 0 300px; /* Width of each card */
    background: white;
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.3s ease;
}

.event-card:hover { transform: translateY(-10px); }

.card-image { position: relative; height: 250px; }
.card-image img { width: 100%; height: 100%; object-fit: cover; }

.date-badge {
    position: absolute;
    top: 0; left: 15px;
    background: #0056b3;
    padding: 10px;
    text-align: center;
    font-size: 12px;
    font-weight: bold;
}
.date-badge span { font-size: 20px; }

.card-info { padding: 20px; color: #333; }
.card-info h4 { font-size: 16px; margin-bottom: 10px; height: 40px; overflow: hidden; }
.card-info p { font-size: 13px; color: #777; font-weight: bold; }

/*8- This section is for the stats of our website in home page */
.impact-section {
    padding: 4rem 2rem;
    background-color: #ffffff;
    text-align: center;
    padding-top: 0px;
}

.impact-header {
    margin-bottom: 3rem;
}

.impact-title {
    font-size: 2.5rem;
    color: #333;
    margin-bottom: 0.5rem;
    position: relative;
    display: inline-block;
}

.impact-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background: linear-gradient(135deg, #FF6B6B 0%, #ff4d4d 100%);
    border-radius: 2px;
}

.impact-caption {
    font-size: 1.1rem;
    color: #666;
    margin-top: 1rem;
}

.stats-container {
    display: flex;
    justify-content: center;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    flex-wrap: wrap;
}

/* --- THE CARD --- */
.stat-card {
    background: white;
    border-radius: 15px;
    padding: 2rem;
    flex: 1;
    min-width: 280px;
    max-width: 350px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
}

/* Horizontal Alignment Fixes */
.stat-flex-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    text-align: left;
}

.stat-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
}

/* --- THE ICON --- */
.stat-icon {
    position: relative;
    width: 80px;
    height: 80px;
    flex-shrink: 0;
}

.stat-icon i {
    font-size: 2.5rem;
    position: absolute;
    transition: all 0.3s ease;
}

.stat-icon i:first-child {
    color: #ff4d4d;
    top: 0;
    left: 0;
}

.stat-icon .icon-secondary {
    color: #FF6B6B;
    font-size: 1.5rem;
    bottom: 0;
    right: 0;
    opacity: 0.7;
}

/* Hover rotation logic */
.stat-card:hover .stat-icon i:first-child {
    transform: rotate(360deg) scale(1.1);
    color: #ff4d4d;
}

.stat-card:hover .stat-icon .icon-secondary {
    transform: rotate(-360deg) scale(1.1);
    color: #FF6B6B;
}

/* --- THE TEXT --- */
.stat-number {
    font-size: 2.2rem;
    font-weight: bold;
    margin: 0;
    background: linear-gradient(135deg, #ff4d4d 0%, #FF6B6B 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.stat-label {
    font-size: 1rem;
    color: #666;
    margin: 0;
    font-weight: 500;
}

/* --- PROGRESS BAR --- */
.progress-bar {
    width: 100%;
    height: 8px;
    background: #e0e0e0;
    border-radius: 10px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(135deg, #ff4d4d 0%, #FF6B6B 100%);
    border-radius: 10px;
    transition: width 0.3s ease;
}

/* Hover Pulse & Shimmer */
.stat-card:hover .progress-fill {
    animation: progressPulse 1s ease infinite;
}

@keyframes progressPulse {
    0% { opacity: 1; }
    50% { opacity: 0.8; box-shadow: 0 0 10px rgba(255, 77, 77, 0.5); }
    100% { opacity: 1; }
}


