    letter-spacing: 2px;
    color: #888;
    text-transform: uppercase;
}

/* THE SOLID COLOR BALLS (The Fun Part) */
.stat-bubble {
    position: absolute;
    border-radius: 50%;
    z-index: 1;
    animation: floatAround 8s infinite ease-in-out;
}

.bubble-red {
    width: 80px; height: 80px;
    background: rgba(255, 75, 75, 0.1); /* Very soft red */
    top: 10%; left: 20%;
}

.bubble-yellow {
    width: 40px; height: 40px;
    background: #ffcc00; /* Solid fun pop */
    bottom: 15%; left: 45%;
    animation-delay: -2s;
}

.bubble-blue {
    width: 60px; height: 60px;
    background: rgba(0, 150, 255, 0.1);
    top: 30%; right: 20%;
    animation-delay: -4s;
}

@keyframes floatAround {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, -30px); }
}

/* Responsive */
@media (max-width: 768px) {
    .hub-container { flex-direction: column; gap: 50px; }
}


