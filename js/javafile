//This is for the number of guests details in the booking page
window.addEventListener('DOMContentLoaded', () => {
    const adultInput = document.getElementById('confirm-adults');
    const childInput = document.getElementById('confirm-children');
    const guestContainer = document.getElementById('dynamic-guest-details');

    function updateGuestForms() {
        const adults = parseInt(adultInput.value) || 0;
        const children = parseInt(childInput.value) || 0;
        const totalGuests = adults + children;

        // 1. Clear previous entries
        guestContainer.innerHTML = '';

        // 2. Add Section Title if guests exist
        if (totalGuests > 1) {
            const sectionTitle = document.createElement('label');
            sectionTitle.className = 'section-label';
            sectionTitle.innerText = "Guest Details";
            sectionTitle.style.display = "block";
            sectionTitle.style.marginBottom = "15px";
            sectionTitle.style.color = "#ff4d4d"; // Matches Rihla Red
            sectionTitle.style.fontWeight = "bold";
            guestContainer.appendChild(sectionTitle);
        }

        // 3. Generate Dropdowns
        for (let i = 2; i <= totalGuests; i++) {
            const isChild = i > adults;
            const guestType = isChild ? "Child" : "Adult";
            
            // We use a <span> for the arrow to ensure it shows even if FontAwesome fails
            const guestHTML = `
                <details class="guest-dropdown">
                    <summary class="dropdown-header">
                        <span class="guest-title">Person ${i} — ${guestType}</span>
                        <span class="custom-arrow"></span>
                    </summary>
                    <div class="guest-form-inner">
                        <div class="item">
                            <label>Full Name</label>
                            <input type="text" name="guest-${i}-name" placeholder="Legal Name">
                        </div>
                        <div class="item">
                            <label>Passport Number</label>
                            <input type="text" name="guest-${i}-passport" placeholder="Required" required>
                        </div>
                        ${isChild ? `
                        <div class="item">
                            <label>Age of Child</label>
                            <input type="number" name="guest-${i}-age" placeholder="Years">
                        </div>` : ''}
                    </div>
                </details>
            `;
            guestContainer.insertAdjacentHTML('beforeend', guestHTML);
        }
    }

    // 4. Event Listeners for Real-time Updates
    if (adultInput) adultInput.addEventListener('input', updateGuestForms);
    if (childInput) childInput.addEventListener('input', updateGuestForms);
    
    // 5. Initial Run (Delayed slightly to ensure URL params are loaded first)
    setTimeout(updateGuestForms, 200); 
});

// This handles clicking on the bars directly
function currentSlide(n) {
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');
    
    // Reset everyone
    slides.forEach(s => s.classList.remove('active'));
    dots.forEach(d => d.classList.remove('active'));
    
    index = n;
    
    // Set the chosen one
    slides[index].classList.add('active');
    if (dots[index]) dots[index].classList.add('active');
}

