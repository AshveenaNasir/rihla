// Function to handle accordion toggle
function toggleAccordion(element) {
    // Optional: Close all other items when one is opened
    const allItems = document.querySelectorAll('.rhl-acc-item');
    allItems.forEach(item => {
        if (item !== element) {
            item.classList.remove('active');
        }
    });

    // Toggle active state for clicked item
    element.classList.toggle('active');
}


//This is for the services offered by rihla
function changeServiceImage(imgSrc, element) {
    const mainImg = document.getElementById('rhlServiceImage');
    
    // Remove active class from all items
    document.querySelectorAll('.rhl-service-item').forEach(item => {
        item.classList.remove('active');
    });

    // Add active class to hovered item
    element.classList.add('active');

    // Change image with smooth transition
    mainImg.style.opacity = '0.4';
    mainImg.style.transform = 'scale(1.05)';

    setTimeout(() => {
        mainImg.src = imgSrc;
        mainImg.style.opacity = '1';
        mainImg.style.transform = 'scale(1)';
    }, 300);
}

