let index = 0;

// This function handles the movement
function moveSlide(step) {
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.dot');

    // 1. Remove 'active' class from current items
    slides[index].classList.remove('active');
    if (dots[index]) dots[index].classList.remove('active');
    
    // 2. Calculate the next index
    index = (index + step + slides.length) % slides.length;
    
    // 3. Add 'active' class to the new items
    slides[index].classList.add('active');
    if (dots[index]) dots[index].classList.add('active');
}

//This is for form info to be thrown to the booking page
// This runs as soon as the Booking Page loads
// PART 1: DATA TRANSFER
window.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);

    const bookingData = {
        destination: params.get('destination'),
        checkin: params.get('checkin'),
        checkout: params.get('checkout'),
        adults: params.get('adults'),
        children: params.get('children'),
        fullname: params.get('fullname')
    };

    // Mapping values to the Confirm Page fields
    if (bookingData.destination) document.getElementById('confirm-dest').value = bookingData.destination;
    if (bookingData.fullname) document.getElementById('confirm-name').value = bookingData.fullname;
    if (bookingData.checkin) document.getElementById('confirm-in').value = bookingData.checkin;
    if (bookingData.checkout) document.getElementById('confirm-out').value = bookingData.checkout;
    if (bookingData.adults) document.getElementById('confirm-adults').value = bookingData.adults;
    if (bookingData.children) document.getElementById('confirm-children').value = bookingData.children;
});

